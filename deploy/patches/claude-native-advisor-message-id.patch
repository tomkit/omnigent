index 000000000..a0a01b9ee
--- /dev/null
+++ b/tests/harnesses/claude_native/test_claude_native_advisor_resume.py
@@ -0,0 +1,71 @@
+"""Rebuilt Claude transcripts keep one API response's blocks grouped by ``message.id``."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from omnigent.harnesses.claude_native import main as claude_native
+
+
+def _rebuild(compacted_messages: list[dict[str, object]]) -> list[dict[str, object]]:
+    items: list[dict[str, object]] = [
+        {
+            "id": "item_1",
+            "type": "compaction",
+            "summary": "summary",
+            "token_count": 10,
+            "compacted_messages": compacted_messages,
+        }
+    ]
+    return claude_native._claude_transcript_records_from_session_items(
+        items,
+        session_id="conv_test",
+        external_session_id="02857840-6362-408f-b41f-309e396ed7c6",
+        cwd=Path("/tmp/test"),
+        bridge_dir=Path("/tmp/test-bridge"),
+    )
+
+
+def _assistant(block: dict[str, object]) -> dict[str, object]:
+    return {"type": "message", "role": "assistant", "content": [block]}
+
+
+def test_advisor_pair_shares_message_id_until_next_user_record() -> None:
+    records = _rebuild(
+        [
+            {"type": "message", "role": "user", "content": "hello"},
+            _assistant(
+                {"type": "server_tool_use", "id": "srvtoolu_1", "name": "advisor", "input": {}}
+            ),
+            _assistant(
+                {
+                    "type": "advisor_tool_result",
+                    "tool_use_id": "srvtoolu_1",
+                    "content": {"type": "advisor_redacted_result", "encrypted_content": "x"},
+                }
+            ),
+            _assistant({"type": "tool_use", "id": "toolu_1", "name": "Bash", "input": {}}),
+            {
+                "type": "message",
+                "role": "user",
+                "content": [{"type": "tool_result", "tool_use_id": "toolu_1", "content": "ok"}],
+            },
+            _assistant({"type": "text", "text": "done"}),
+        ]
+    )
+    assistant_ids = [r["message"].get("id") for r in records if r.get("type") == "assistant"]
+    assert len(assistant_ids) == 4
+    first_response, second_response = assistant_ids[:3], assistant_ids[3]
+    assert len(set(first_response)) == 1
+    assert first_response[0].startswith("msg_")
+    assert second_response != first_response[0]
+
+
+def test_existing_message_id_is_kept() -> None:
+    message = _assistant({"type": "text", "text": "hi"})
+    records = _rebuild([{"type": "message", "role": "user", "content": "hello"}, message])
+    for record in records:
+        if record.get("type") == "assistant":
+            record["message"]["id"] = "msg_real"
+    claude_native._group_assistant_records_by_response(records)
+    assert [r["message"]["id"] for r in records if r.get("type") == "assistant"] == ["msg_real"]
