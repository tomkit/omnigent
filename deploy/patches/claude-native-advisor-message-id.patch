+def _group_assistant_records_by_response(records: list[_JsonObject]) -> None:
+    """
+    Give each run of consecutive assistant records one shared ``message.id``.
+
+    Claude Code writes one API response as several records sharing a
+    ``message.id`` and regroups them by that id on ``--resume``. Without it,
+    server-tool pairs (``server_tool_use`` + ``advisor_tool_result``) are
+    split apart and the API rejects the whole request with a 400.
+
+    :param records: Claude transcript records in order (mutated).
+    :returns: None.
+    """
+    run_id: str | None = None
+    for record in records:
+        message = record.get("message")
+        if record.get("type") != "assistant" or not isinstance(message, dict):
+            run_id = None
+            continue
+        if run_id is None:
+            existing = message.get("id")
+            run_id = (
+                existing
+                if isinstance(existing, str) and existing
+                else f"msg_omnigent_{str(record.get('uuid', '')).replace('-', '')}"
+            )
+        message.setdefault("id", run_id)
+
